{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nanobanana.shop/schemas/pricing-config.json",
  "title": "Pricing Configuration",
  "description": "Centralized pricing config - set by marketing, read-only for customer agents",
  "type": "object",
  "required": ["version", "updatedAt", "basePrices", "tierBenefits", "constraints"],
  "properties": {
    "version": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string" },
    "basePrices": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/productPrice" }
    },
    "tierBenefits": {
      "type": "object",
      "properties": {
        "standard": { "$ref": "#/definitions/tierBenefit" },
        "silver": { "$ref": "#/definitions/tierBenefit" },
        "gold": { "$ref": "#/definitions/tierBenefit" },
        "platinum": { "$ref": "#/definitions/tierBenefit" }
      }
    },
    "activePromotions": { "type": "array", "items": { "$ref": "#/definitions/promotion" } },
    "discountCodes": { "type": "array", "items": { "$ref": "#/definitions/discountCode" } },
    "constraints": { "$ref": "#/definitions/pricingConstraints" }
  },
  "definitions": {
    "productPrice": {
      "type": "object",
      "required": ["basePrice", "cost", "minMargin"],
      "properties": {
        "basePrice": { "type": "number", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "minMargin": { "type": "number", "minimum": 0, "maximum": 1 },
        "displayName": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "tierBenefit": {
      "type": "object",
      "properties": {
        "discountPercent": { "type": "number", "minimum": 0, "maximum": 50 },
        "freeShippingThreshold": { "type": "number", "minimum": 0 },
        "prioritySupport": { "type": "boolean" },
        "earlyAccess": { "type": "boolean" },
        "maxDiscountStack": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "promotion": {
      "type": "object",
      "required": ["id", "name", "type", "value", "validFrom", "validUntil", "active"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "fixed", "shipping", "bogo"] },
        "value": { "type": "number", "minimum": 0 },
        "conditions": { "$ref": "#/definitions/promotionConditions" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" },
        "usageLimit": { "type": "integer", "minimum": 0 },
        "usageCount": { "type": "integer", "minimum": 0 }
      }
    },
    "promotionConditions": {
      "type": "object",
      "properties": {
        "minOrderValue": { "type": "number", "minimum": 0 },
        "minItems": { "type": "integer", "minimum": 1 },
        "applicableProducts": { "type": "array", "items": { "type": "string" } },
        "applicableTiers": { "type": "array", "items": { "type": "string", "enum": ["standard", "silver", "gold", "platinum"] } },
        "newCustomersOnly": { "type": "boolean" }
      }
    },
    "discountCode": {
      "type": "object",
      "required": ["code", "promotionId", "validFrom", "validUntil", "active"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9]{4,20}$" },
        "promotionId": { "type": "string", "format": "uuid" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" },
        "singleUse": { "type": "boolean" },
        "usedBy": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pricingConstraints": {
      "type": "object",
      "required": ["absoluteMinMargin", "maxDiscountPercent", "maxStackedDiscount"],
      "properties": {
        "absoluteMinMargin": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxDiscountPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxStackedDiscount": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
